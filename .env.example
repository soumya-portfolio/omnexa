# Environment Variables for OMNEXA Technologies

# Example environment variables - copy to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME=OMNEXA Technologies
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=
API_SECRET_KEY=

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Database (if needed)
DATABASE_URL=

# Third-party Services (if needed)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Analytics (if needed)
NEXT_PUBLIC_GA_ID=
